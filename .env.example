# ==========================================
# RENOVRA - FREE ECOSYSTEM CONFIGURATION
# ==========================================

# 1. Supabase (Database & Storage - 100% Free)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
ADMIN_EMAIL=admin@renovra.com

# 2. Telegram Bot (Instant Order Alerts - 100% Free)
# Telegram-এ @BotFather এ গিয়ে /newbot লিখে আপনার বট টোকেন নিন
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram-এ @userinfobot এ গিয়ে আপনার Chat ID নিন (ব্যক্তিগত চ্যাট বা চ্যানেলের ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 3. Live Website URL (Cloudflare Pages বা Vercel ডোমেন)
NEXT_PUBLIC_SITE_URL=https://your-domain.pages.dev
