# 1. Telegram Bot (অর্ডার নোটিফিকেশন ও অ্যালার্টের জন্য)
# @BotFather থেকে পাওয়া বট টোকেন
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# @userinfobot থেকে পাওয়া চ্যাট বা চ্যানেল আইডি
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 2. Admin Dashboard Credentials (আপনার Gmail ও সিকিউর পাসওয়ার্ড)
ADMIN_EMAIL=renovrait@gmail.com
ADMIN_PASSWORD=your_strong_admin_password_here

# 3. Live Site URL
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 4. Cloudflare D1 Database (ঐচ্ছিক - দিলে ক্লাউডে সেভ হবে, না দিলে লোকাল সেভ থাকবে)
# Cloudflare Dashboard -> Workers & Pages -> D1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
