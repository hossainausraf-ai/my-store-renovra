{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "renovra-db",
      "database_id": "d7e8d988-1629-4301-aa1b-88cd6b437cd3"
    }
  ]
}
